{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ast-index update",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../books", "../books-app-docs"],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [],
    "deny": [
      "Bash(yarn prisma:migrate:*)",
      "Bash(yarn prisma:seed:*)",
      "Bash(yarn prisma:studio:*)",
      "Bash(npx prisma:*)",
      "Bash(prisma:*)",
      "Bash(psql:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose -f docker-compose.prod.yml:*)",
      "Bash(docker compose -f docker-compose.monitoring.yml:*)",
      "Bash(docker compose --profile prod:*)",
      "Bash(docker exec:*)",
      "Bash(docker run:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//d/newDev/.env.prod.server)"
    ]
  }
}
