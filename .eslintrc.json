{
  "extends": ["next/core-web-vitals", "next/typescript", "plugin:jsx-a11y/recommended"],
  "rules": {
    // Import order according to CODE_STYLE.md
    "import/order": [
      "error",
      {
        "groups": [
          ["builtin", "external"], // 1. React and libraries
          "internal", // 2-4. Internal components, utilities
          "type", // 5. Types
          ["parent", "sibling", "index"] // 6. Styles (last)
        ],
        "pathGroups": [
          {
            "pattern": "react",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "@/styles/**",
            "group": "index",
            "position": "after"
          },
          {
            "pattern": "**/*.scss",
            "group": "index",
            "position": "after"
          },
          {
            "pattern": "**/*.css",
            "group": "index",
            "position": "after"
          }
        ],
        "pathGroupsExcludedImportTypes": ["react"],
        "newlines-between": "never",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ],
    // Require type for type imports
    "@typescript-eslint/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "disallowTypeAnnotations": false,
        "fixStyle": "separate-type-imports"
      }
    ],
    // Prohibit unused variables (except those starting with _)
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // 🔴 LEGACY-158. Запрет инлайн-стилей объявлен в AGENTS.md и CODE_STYLE.md, а
    // стерёг его один тест на один компонент. Уровень `error` глобальный: любой новый
    // или тронутый файл вне списка должников ниже роняет `yarn lint`. Понижать
    // глобальный уровень до `warn` бессмысленно — `yarn lint` идёт без
    // `--max-warnings`, предупреждение конвейер не красит (это LEGACY-182).
    "react/forbid-dom-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "style",
            "message": "Инлайн-стили запрещены: класс в соседнем .module.scss, значения из styles/tokens.scss. Накопленное — LEGACY-050."
          }
        ]
      }
    ],
    // 🔴 LEGACY-016, пункт a11y. Пять правил ниже стояли уровнем `warn`, а `yarn lint`
    // идёт без `--max-warnings` — 39 живых нарушений не меняли кода возврата, и правила
    // не стерегли ничего. Уровень `error` без списка исключений: долг разобран тем же
    // заходом 09.09.2026, поэтому понижать больше нечего. Решение арбитра от 09.09.2026,
    // строка в `books-app-docs/ai-context/decisions-log.md`.
    //
    // ⚠️ `--max-warnings` здесь по-прежнему нет намеренно: живые предупреждения
    // дерева — это накопленный долг инлайн-стилей (LEGACY-050), он разбирается своей
    // записью и к a11y отношения не имеет. Число не пишется: оно протухает с первой
    // же снятой строкой долга (LEGACY-167), считать листингом —
    // `yarn lint 2>&1 | grep -c "react/forbid-dom-props"`.
    //
    // `media-has-caption` остаётся выключенным: субтитры к аудиокнигам продукт
    // не производит, включённое правило краснело бы на каждом плеере.
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/img-redundant-alt": "error",
    // 🔴 LEGACY-419. `JSON.stringify` не экранирует `<`: текст FAQ `</script><img onerror=…>`
    // закрывал блок JSON-LD и исполнялся на публичной странице. Вывод только через
    // `serializeJsonLd` из `lib/utils/json-ld.ts`. Сторож — `__tests__/eslintJsonLdRule.test.ts`.
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXAttribute[name.name='dangerouslySetInnerHTML'] CallExpression[callee.object.name='JSON'][callee.property.name='stringify']",
        "message": "JSON.stringify в dangerouslySetInnerHTML не экранирует `<` — используй serializeJsonLd из @/lib/utils/json-ld (LEGACY-419)."
      },
      {
        // Строка, собранная заранее в переменной, обходит первое правило — у <script> тело только прямым вызовом.
        "selector": "JSXOpeningElement[name.name='script'] Property[key.name='__html']:not([value.callee.name='serializeJsonLd'])",
        "message": "Тело <script> — только прямым вызовом serializeJsonLd(...) из @/lib/utils/json-ld (LEGACY-419)."
      }
    ],
    // 🔴 LEGACY-442. Та же граница по настоящему пути файла, а не по строке импорта:
    // шаблоны `no-restricted-imports` ниже видят текст `'../../admin/common/Modal'`,
    // а этот запрет — куда он ведёт. Зона админки снимает его в override ниже.
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": ["./app", "./components", "./lib", "./providers", "./api", "./types"],
            "from": ["./components/admin", "./app/admin"],
            "message": "Админские компоненты тянут antd — на сайте их не импортировать (LEGACY-442)."
          }
        ]
      }
    ],
    // 🔴 LEGACY-442. antd — библиотека одной админки: на публичных страницах она тянула
    // свой рантайм в клиентский бандл и расходилась со стилем сайта. Запрещены и сам antd,
    // и админские компоненты, которые на нём построены. Разрешённая зона —
    // override ниже (`app/admin/**`, `components/admin/**`, `providers/LazyConfigProvider.tsx`).
    // Сторож — `__tests__/eslintAntdBoundary.test.ts`.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["antd", "antd/*", "@ant-design/*"],
            "message": "antd — только в админке (app/admin/**, components/admin/**). На сайте — свои компоненты из components/common и lucide-react (LEGACY-442)."
          },
          {
            // Админские компоненты построены на antd: импорт их с сайта возвращает antd
            // в публичный бандл в обход первой группы (так были устроены common/Modal
            // и common/SlugInput до переезда в components/admin/common).
            "group": [
              "@/components/admin",
              "@/components/admin/*",
              "@/app/admin/*",
              "**/components/admin",
              "**/components/admin/**",
              "**/app/admin/**"
            ],
            "message": "Админские компоненты тянут antd — на сайте их не импортировать. Окно сайта — components/common/ConfirmDialog, кнопка — components/common/Button (LEGACY-442)."
          }
        ]
      }
    ]
  },
  // Каталоги, которых линт не касается. `next lint` фильтровал охват своим списком
  // `eslint.dirs`, и половина кода оставалась непроверенной (LEGACY-151); прямой вызов
  // `eslint .` идёт по всему дереву, поэтому исключения нужны здесь и явно.
  //
  // ⚠️ Три записи на точку (`.next/`, `.claude/`, `.yarn-cache/`) сами по себе инертны:
  // ESLint 8 в каталоги, имя которых начинается с точки, не спускается и без них.
  // Они оставлены как явная запись того, что внутри репозитория лежат вторые копии кода
  // — `.yarn-cache` (около 25 000 файлов `.ts`) и `.claude/worktrees` (рабочая копия чужой
  // ветки), — и чтобы список читался рядом со списком `exclude` из `tsconfig.json`.
  // Полагаться на них как на действующее исключение нельзя.
  //
  // 🔴 Каждый путь заякорен ведущей косой, и это не стиль. ESLint читает эти шаблоны
  // по правилам `.gitignore`: запись без ведущей косой совпадает с каталогом такого
  // имени **на любой глубине**. Первая версия этого списка содержала `public/` — и
  // выключала из линта весь `components/public`, то есть 31 компонент публичного сайта
  // и 17 тестов к ним. Правка, расширяющая охват, молча закрывала самый крупный кусок
  // продукта; поймало это ревью, а не проверка. Сторож на такой возврат — в
  // `__tests__/lint-coverage.test.ts`: он спрашивает `isPathIgnored` по каждому файлу
  // дерева, а не по одному образцу из каталога.
  "ignorePatterns": [
    "/node_modules/",
    "/.next/",
    "/.claude/",
    "/.yarn-cache/",
    "/coverage/",
    "/playwright-report/",
    "/test-results/",
    "/dist/",
    "/build/",
    "/out/",
    "/public/",
    "/next-env.d.ts"
  ],
  "overrides": [
    {
      // 🔴 LEGACY-158, долг на момент введения правила: файлы, в которых инлайн-стили
      // уже накоплены. Понижение до `warn` — не поблажка, а зафиксированная граница:
      // всё, чего в этом списке нет, роняет `yarn lint` жёстко. Разбор самих
      // нарушений идёт по LEGACY-050 и здесь не делается.
      //
      // ⚠️ Список **только сокращается**. Дописать сюда файл — значит расширить долг
      // молча; сторож `__tests__/eslintInlineStyles.test.ts` держит и это, и обратное:
      // запись, под которой нарушения больше нет, обязана быть удалена.
      "files": [
        "app/*/book/*/listen/ListenClient.tsx",
        "app/*/book/*/page.tsx",
        "app/*/book/*/read/ReaderClient.tsx",
        "app/*/profile/ProfileClient.tsx",
        "app/admin/*/error.tsx",
        "app/admin/*/media/page.tsx",
        "components/admin/AdminShell/AdminTopBar/AdminTopBar.tsx",
        "components/admin/AdminShell/PurgeCacheButton/PurgeCacheButton.tsx",
        "components/admin/authors/AuthorList/AuthorList.tsx",
        "components/admin/books/BookForm/DetailInfoSection.tsx",
        "components/admin/books/ListenContentTab/AudioPicker.tsx",
        "components/admin/categories/CategoryTranslationsModal/TranslationForm.tsx",
        "components/admin/categories/CategoryTree/CategoryTree.tsx",
        "components/admin/categories/CategoryTree/CategoryTreeNode.tsx",
        "components/admin/comments/CommentsList.tsx",
        "components/admin/media/MediaList.tsx",
        "components/admin/media/UploadProgress.tsx",
        "components/admin/shared/Skeleton/Skeleton.tsx",
        "components/admin/tags/TagTranslationsModal/TranslationForm.tsx",
        "components/public/layout/Footer.tsx",
        "components/public/layout/Header.tsx"
      ],
      "rules": { "react/forbid-dom-props": "warn" }
    },
    {
      // `return somePromise` inside `try` does not put the rejection anywhere the
      // `catch` can see it — the caller receives the rejected promise instead. Two
      // helpers literally named *Safe were written that way and caught nothing,
      // which is how one failing homepage section blanked the whole page. This is
      // a type-aware rule, hence the separate override with `project`.
      "files": ["**/*.ts", "**/*.tsx"],
      "parserOptions": { "project": "./tsconfig.json" },
      "rules": {
        "@typescript-eslint/return-await": ["error", "in-try-catch"]
      }
    },
    {
      // Тесты админки законно импортируют её код: в бандл сайта они не попадают. Запрет
      // antd здесь остаётся тем же, снята только вторая группа (админские компоненты).
      "files": ["__tests__/**", "e2e/**"],
      "rules": {
        "import/no-restricted-paths": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["antd", "antd/*", "@ant-design/*"],
                "message": "antd — только в админке (app/admin/**, components/admin/**). На сайте — свои компоненты из components/common и lucide-react (LEGACY-442)."
              }
            ]
          }
        ]
      }
    },
    {
      // Зона antd (LEGACY-442): админка и её тема. Правило снято здесь целиком, потому что
      // других запретов импорта в проекте нет; появится второй — перенести сюда его копию.
      "files": ["app/admin/**", "components/admin/**", "providers/LazyConfigProvider.tsx"],
      "rules": { "no-restricted-imports": "off", "import/no-restricted-paths": "off" }
    }
  ]
}
