{
  "extends": ["next/core-web-vitals", "next/typescript", "plugin:jsx-a11y/recommended"],
  "rules": {
    // Import order according to CODE_STYLE.md
    "import/order": [
      "error",
      {
        "groups": [
          ["builtin", "external"], // 1. React and libraries
          "internal", // 2-4. Internal components, utilities
          "type", // 5. Types
          ["parent", "sibling", "index"] // 6. Styles (last)
        ],
        "pathGroups": [
          {
            "pattern": "react",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "@/styles/**",
            "group": "index",
            "position": "after"
          },
          {
            "pattern": "**/*.scss",
            "group": "index",
            "position": "after"
          },
          {
            "pattern": "**/*.css",
            "group": "index",
            "position": "after"
          }
        ],
        "pathGroupsExcludedImportTypes": ["react"],
        "newlines-between": "never",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ],
    // Require type for type imports
    "@typescript-eslint/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "disallowTypeAnnotations": false,
        "fixStyle": "separate-type-imports"
      }
    ],
    // Prohibit unused variables (except those starting with _)
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // Accessibility rule custom overrides
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/img-redundant-alt": "warn"
  },
  // Каталоги, которых линт не касается. `next lint` фильтровал охват своим списком
  // `eslint.dirs`, и половина кода оставалась непроверенной (LEGACY-151); прямой вызов
  // `eslint .` идёт по всему дереву, поэтому исключения нужны здесь и явно.
  //
  // ⚠️ Три записи на точку (`.next/`, `.claude/`, `.yarn-cache/`) сами по себе инертны:
  // ESLint 8 в каталоги, имя которых начинается с точки, не спускается и без них.
  // Они оставлены как явная запись того, что внутри репозитория лежат вторые копии кода
  // — `.yarn-cache` (около 25 000 файлов `.ts`) и `.claude/worktrees` (рабочая копия чужой
  // ветки), — и чтобы список читался рядом со списком `exclude` из `tsconfig.json`.
  // Полагаться на них как на действующее исключение нельзя.
  //
  // 🔴 Каждый путь заякорен ведущей косой, и это не стиль. ESLint читает эти шаблоны
  // по правилам `.gitignore`: запись без ведущей косой совпадает с каталогом такого
  // имени **на любой глубине**. Первая версия этого списка содержала `public/` — и
  // выключала из линта весь `components/public`, то есть 31 компонент публичного сайта
  // и 17 тестов к ним. Правка, расширяющая охват, молча закрывала самый крупный кусок
  // продукта; поймало это ревью, а не проверка. Сторож на такой возврат — в
  // `__tests__/lint-coverage.test.ts`: он спрашивает `isPathIgnored` по каждому файлу
  // дерева, а не по одному образцу из каталога.
  "ignorePatterns": [
    "/node_modules/",
    "/.next/",
    "/.claude/",
    "/.yarn-cache/",
    "/coverage/",
    "/playwright-report/",
    "/test-results/",
    "/dist/",
    "/build/",
    "/out/",
    "/public/",
    "/next-env.d.ts"
  ],
  "overrides": [
    {
      // `return somePromise` inside `try` does not put the rejection anywhere the
      // `catch` can see it — the caller receives the rejected promise instead. Two
      // helpers literally named *Safe were written that way and caught nothing,
      // which is how one failing homepage section blanked the whole page. This is
      // a type-aware rule, hence the separate override with `project`.
      "files": ["**/*.ts", "**/*.tsx"],
      "parserOptions": { "project": "./tsconfig.json" },
      "rules": {
        "@typescript-eslint/return-await": ["error", "in-try-catch"]
      }
    }
  ]
}
